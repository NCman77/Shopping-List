rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/users/{userId} {
      function isOwner() {
        return appId == 'japan-shopping-app'
          && request.auth != null
          && request.auth.uid == userId;
      }

      function itemTripReferenceIsValid() {
        return !request.resource.data.keys().hasAny(['tripId'])
          || (request.resource.data.tripId is string
            && (request.resource.data.tripId == ''
              || (existsAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/trips/$(request.resource.data.tripId))
                && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/trips/$(request.resource.data.tripId)).data.get('deleting', false) != true)));
      }

      match /items/{itemId} {
        allow read, delete: if isOwner();
        allow create: if isOwner()
          && request.resource.data.get('tripId', '') is string
          && request.resource.data.get('tripId', '') != ''
          && itemTripReferenceIsValid();
        allow update: if isOwner() && (
          request.resource.data.get('tripId', '') == resource.data.get('tripId', '')
          || itemTripReferenceIsValid()
        );
      }

      match /trips/{tripId} {
        allow read, create, update: if isOwner();
        allow delete: if isOwner() && (
          resource.data.get('kind', '') == 'legacy'
          || (resource.data.get('deleting', false) == true
            && resource.data.get('deletingToken', '') is string
            && resource.data.deletingToken != '')
        );
      }

      match /settings/{settingId} {
        allow read, write: if isOwner();
      }

      match /brands/{brandId} {
        allow read, write: if isOwner();
      }

      match /itemPhotos/{photoId} {
        allow read, write: if isOwner();
      }

      match /itemPhotoPreviews/{previewId} {
        allow read, write: if isOwner();
      }
    }

    match /artifacts/{appId}/clientErrors/{errorId} {
      allow create: if appId == 'japan-shopping-app'
        && request.auth != null
        && request.auth.uid != ''
        && request.resource.data.keys().hasOnly([
          'name', 'message', 'stack', 'source', 'path', 'line', 'column', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 1800
        && request.resource.data.source is string
        && request.resource.data.path is string
        && (request.resource.data.line == null || request.resource.data.line is int)
        && (request.resource.data.column == null || request.resource.data.column is int)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
